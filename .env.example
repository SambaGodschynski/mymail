# Copy to ~/.config/mymail/.env and fill in your own values. Keep it out of the
# checkout: this is a session credential for your mailbox, and a file sitting
# next to the source is one stray `git add -f` away from being public.
#
# A Microsoft Graph bearer token from your own logged-in browser session. Paste
# it as it is — everything after the first "=" is the value, so the token's own
# dots and dashes need no quoting. See the README for where to find one.
#
# It needs the Mail.Read scope — see the README, this is the step that's easy to
# miss. A "Bearer " prefix copied along with it is stripped.
#
# It expires: after a day at most, often after an hour. That is a property of
# the token, not of this tool — when it does, mymail says so and stops.
MAIL_TOKEN=

# How often to ask for new mail once the backfill is done. Graph has no way to
# push mail to a local program, so this polls — see the README.
POLL_INTERVAL=30s

# Which folder to follow. "inbox" is what arrives; "allmail" watches every
# folder, including what rules have already filed away.
MAIL_FOLDER=inbox
